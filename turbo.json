{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "VITE_FIREBASE_ANALYTICS_CONSENT",
        "VITE_FIREBASE_ANALYTICS_ENABLED",
        "VITE_FIREBASE_API_KEY",
        "VITE_FIREBASE_APP_ID",
        "VITE_FIREBASE_AUTH_DOMAIN",
        "VITE_FIREBASE_MEASUREMENT_ID",
        "VITE_FIREBASE_MESSAGING_SENDER_ID",
        "VITE_FIREBASE_PROJECT_ID",
        "VITE_FIREBASE_STORAGE_BUCKET",
        "VITE_LUPI_ANALYTICS_URL",
        "VITE_LUPI_AUTH_FLOW",
        "VITE_LUPI_BUILD_SHA",
        "VITE_LUPI_MCP_ENDPOINT",
        "VITE_NIST_BASE_URL"
      ],
      "outputs": ["dist/**", "pkg/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@atlas/core#build": { "outputs": [] },
    "@atlas/parsers#build": { "outputs": [] },
    "@atlas/renderer#build": { "outputs": [] },
    "@atlas/scene#build": { "outputs": [] },
    "@atlas/ui#build": { "outputs": [] },
    "@lupine/ui#build": { "outputs": [] },
    "@atlas/remotion-trailer#build": { "outputs": [] },
    "test": {
      "outputs": [],
      "dependsOn": ["build"]
    },
    "lint": {
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
