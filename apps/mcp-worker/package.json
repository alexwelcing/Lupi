{
  "name": "@atlas/mcp-worker",
  "version": "0.1.0",
  "description": "Cloudflare edge Worker for the Lupi web app and MCP control plane",
  "private": true,
  "type": "module",
  "dependencies": {
    "@atlas/assessment": "workspace:*",
    "@atlas/core": "workspace:*",
    "@modelcontextprotocol/core": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "zod": "4.6.5"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "pnpm --filter @atlas/web build && npx -y wrangler@4.110.0 dev --local",
    "dev:worker": "npx -y wrangler@4.110.0 dev --local",
    "deploy": "pnpm --filter @atlas/web build && npx -y wrangler@4.110.0 deploy",
    "deploy:worker": "npx -y wrangler@4.110.0 deploy",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  }
}
