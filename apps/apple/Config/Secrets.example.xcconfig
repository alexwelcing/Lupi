// Copy to Config/Secrets.xcconfig (git ignores it) and fill in, then build again.
// The key is the iOS-restricted API key of Firebase project shed-489901
// (Google Cloud console > APIs & Services > Credentials; application restriction
// "iOS apps": live.lupi.app; API restrictions: Identity Toolkit API and Token
// Service API). It ships inside the app; the restriction is what protects it.
LUPI_FIREBASE_API_KEY = AIza-your-ios-restricted-key
LUPI_FIREBASE_PROJECT_ID = shed-489901
