{
  "name": "@lupi/mobile",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:mcp": "node scripts/start-expo-mcp.mjs",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint app src app.config.ts scripts plugins",
    "test": "node scripts/run-unit-tests.mjs",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --clear",
    "visual:web": "pnpm export:web && node scripts/capture-web-composition.mjs",
    "visual:web:quick": "pnpm export:web && node scripts/capture-web-composition.mjs --quick",
    "export:ios": "expo export --platform ios --output-dir dist-ios --clear",
    "check:testflight": "node scripts/check-testflight-readiness.mjs",
    "check:resolved-expo-config": "node scripts/check-resolved-expo-config.mjs",
    "test:resolved-expo-config": "node --test scripts/check-resolved-expo-config.test.mjs",
    "check:testflight:release": "node scripts/check-testflight-readiness.mjs --release",
    "check:eas-archive": "node scripts/check-eas-archive.mjs .verify-artifacts/mobile-eas-archive",
    "check:visual-workflow:local": "node scripts/check-visual-workflow.mjs",
    "check:visual-workflow": "pnpm check:visual-workflow:local && npx --yes eas-cli@21.7.0 workflow:validate .eas/workflows/mobile-visual.yml --non-interactive && npx --yes eas-cli@21.7.0 workflow:validate .eas/workflows/mobile-visual-capture.yml --non-interactive && npx --yes eas-cli@21.7.0 workflow:validate .eas/workflows/mobile-visual-ar-diagnostic.yml --non-interactive",
    "visual:ios:cloud": "npx --yes eas-cli@21.7.0 workflow:run .eas/workflows/mobile-visual.yml --wait",
    "inspect:eas-archive": "npx --yes eas-cli@21.7.0 build:inspect --platform ios --stage archive --profile production --output .verify-artifacts/mobile-eas-archive --force && node scripts/check-eas-archive.mjs .verify-artifacts/mobile-eas-archive",
    "check:expo": "node scripts/check-expo-dependencies.mjs",
    "verify:testflight": "node scripts/verify-testflight.mjs"
  },
  "dependencies": {
    "@atlas/core": "workspace:^",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.9",
    "@reactvision/react-viro": "2.57.5",
    "expo": "~57.0.12",
    "expo-constants": "~57.0.10",
    "expo-dev-client": "~57.0.11",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.13",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.2",
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "expo-mcp": "~0.2.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
